# ---- Squas Cluster Connect backend configuration ----

# App
APP_NAME="Squas Cluster Connect"
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local zero-config default is SQLite. For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://squas:squas@localhost:5432/squas
DATABASE_URL=sqlite:///./squas.db

# OTP / Auth
# In development, the OTP code is returned in the API response so you can test
# without a real SMS gateway. NEVER enable this in production.
OTP_DEV_ECHO=true
OTP_TTL_SECONDS=300

# Maps (frontend consumes these; kept here for a single source of truth)
MAPS_PROVIDER=google        # google | mapbox
MAPS_API_KEY=

# Object storage for proof photos (S3 / GCS compatible)
STORAGE_BUCKET=squas-proofs
STORAGE_BASE_URL=

# Notification channels (stubbed drivers in services/notifications.py)
FCM_SERVER_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=

# Billing defaults
DEFAULT_RATE_PER_LITRE=0.50
CURRENCY=INR
