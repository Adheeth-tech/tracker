# ---- Squas Cluster Connect backend configuration ----

# App
APP_NAME="Squas Cluster Connect"
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If DATABASE_URL is set, it overrides the environment defaults.
# Otherwise, DEV_DATABASE_URL is used in development and PROD_DATABASE_URL is used in production.
DATABASE_URL=
DEV_DATABASE_URL=sqlite:///./squas.db
PROD_DATABASE_URL=sqlitecloud://<hostname>:8860/<dbname>.db?apikey=<apikey>

# OTP / Auth
# In development, the OTP code is returned in the API response so you can test
# without a real SMS gateway. NEVER enable this in production.
OTP_DEV_ECHO=true
OTP_TTL_SECONDS=300
DEV_OTP=123456

# Billing defaults
DEFAULT_RATE_PER_LITRE=0.50

# Navigation / tracking
# Keep this token server-side and restrict it in the Mapbox dashboard.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PROFILE=mapbox/driving
PLANT_NAME="Central Wastewater Treatment Plant"
PLANT_ADDRESS="Treatment Centre, Thrissur, Kerala"
PLANT_LATITUDE=
PLANT_LONGITUDE=
TRACKING_STALE_AFTER_SECONDS=60
